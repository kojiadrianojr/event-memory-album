# Photo Album — local environment template
# First-time setup: make setup (copies this file to .env.local if missing)

# Host bind address for the app container (make docker:full / make share:local)
APP_HOST=localhost

# Database — local Docker Postgres (default for development)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/photoalbum
# Direct connection for Prisma migrations (same as DATABASE_URL locally)
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/photoalbum

# Postgres container credentials (docker compose db service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=photoalbum

# S3-compatible storage (MinIO via Docker)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=photo-album
S3_PUBLIC_URL=http://localhost:9000/photo-album
S3_PORT=9000
S3_CONSOLE_PORT=9001

# App
ADMIN_BCRYPT_ROUNDS=12

# Platform host login — required to create events (creation blocked when unset)
HOST_ACCESS_SECRET=

# Guest session cookie signing key (required in production; dev falls back to an insecure default)
SESSION_SECRET=dev-insecure-session-secret

# Docker full stack (make docker:full / make share:local)
# DATABASE_URL above targets localhost for npm run dev; the app container uses the db service name:
DOCKER_DATABASE_URL=postgresql://postgres:postgres@db:5432/photoalbum
# Browsers ignore Secure cookies over HTTP — keep false for local Docker
COOKIE_SECURE=false
# Proxy uploads through the app when true; auto-enabled when COOKIE_SECURE=true
# S3_DIRECT_UPLOAD=false
# App container uses internal MinIO hostname for server-side PUTs (make docker:full):
# S3_INTERNAL_ENDPOINT=http://storage:9000
APP_PORT=3000
# HOST_IP is auto-detected by make share:local; set manually if needed (e.g. HOST_IP=192.168.1.5)

# Redis (Docker — rate limits, caching, presence, idempotency; omit to use in-memory fallback)
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
# App container uses the redis service hostname (make docker:full / make share:local):
DOCKER_REDIS_URL=redis://redis:6379

# Pangolin / Newt tunnel (started with make docker:full when vars are set)
# PANGOLIN_ENDPOINT=https://your-pangolin.example.com
# NEWT_ID=
# NEWT_SECRET=

# Rate limiting (optional — defaults shown)
# RATE_LIMIT_CREATE_EVENT=10      # per IP per hour
# RATE_LIMIT_PRESIGNED=60         # per IP per minute
# RATE_LIMIT_RECORD_MEDIA=120     # per IP per minute
# RATE_LIMIT_HOST_ACCESS_AUTH=30  # per IP per minute

# Cache TTLs (seconds — optional, defaults shown)
# CACHE_TTL_EVENT=900        # token→event lookup
# CACHE_TTL_FEED=30          # gallery feed slices
# CACHE_TTL_WALL=60          # contributor wall aggregation
# CACHE_TTL_LOOKUP=3600      # view/invite lookup APIs
# PRESENCE_TTL_SEC=90        # guest wall online window
# IDEMPOTENCY_TTL_SEC=86400  # upload dedupe window
